FOR .env

✅ Best Practice: Jenkins ke through .env file banane ka tarika
🔐 1. Jenkins Credentials me values add karo (Secrets Store)

Jenkins dashboard me jaake:

    Manage Jenkins → Credentials → (Global or Project-specific) → Add Credentials

    Type: "Secret text" (or Username and Password if needed)

    Add following secrets one by one:

        DJANGO_SECRET_KEY

        ALLOW_HOST

        USER_KEY

        ADMIN_KEY

    Har ek key ko ek alag Credential ID se save karo.



set ID like this  === >>>    TEST_PROJECT_DJANGO_SECRET_KEY



pipeline {
    agent any

    environment {
        DJANGO_SECRET_KEY = credentials('DJANGO_SECRET_KEY_ID')
        ALLOW_HOST = credentials('ALLOW_HOST_ID')
        USER_KEY = credentials('USER_KEY_ID')
        ADMIN_KEY = credentials('ADMIN_KEY_ID')
    }

    stages {
        stage('Generate .env File') {
            steps {
                script {
                    def envContent = """
DJANGO_SECRET_KEY=${env.DJANGO_SECRET_KEY}
ALLOW_HOST=${env.ALLOW_HOST}
USER_KEY=${env.USER_KEY}
ADMIN_KEY=${env.ADMIN_KEY}
"""
                    writeFile file: '.env', text: envContent
                }
                echo '.env file created successfully'
            }
        }

        // Continue with your Build/Deploy stages
    }
}


